# Copy this file to .env and adjust values for your local MySQL installation.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sih26101_db

# Use a long random value in production; do not commit the populated .env file.
FLASK_SECRET_KEY=

# Optional: enables Gemini question generation. The application otherwise uses
# its checked-in local question bank/fallback paths where supported.
GEMINI_API_KEY=
